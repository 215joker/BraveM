<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/sheet_profile_image"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@color/ink_100"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.BraveM.Circle"
            app:strokeColor="@color/amber_600"
            app:strokeWidth="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheet_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="User Name"
                android:textColor="@color/ink_900"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sheet_user_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="user@example.com"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp"
        app:dividerColor="@color/divider" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_view_profile"
        style="@style/Widget.BraveM.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/profile"
        app:icon="@drawable/ic_person"
        app:iconPadding="16dp"
        app:iconTint="@color/ink_900" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_notifications"
        style="@style/Widget.BraveM.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/notifications"
        app:icon="@drawable/ic_notifications"
        app:iconPadding="16dp"
        app:iconTint="@color/ink_900" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        style="@style/Widget.BraveM.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/app_settings"
        app:icon="@drawable/ic_settings"
        app:iconPadding="16dp"
        app:iconTint="@color/ink_900" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_admin"
        style="@style/Widget.BraveM.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/admin_dashboard"
        android:visibility="gone"
        app:icon="@drawable/ic_bravem_logo"
        app:iconPadding="16dp"
        app:iconTint="@color/ink_900" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        app:dividerColor="@color/divider" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_logout"
        style="@style/Widget.BraveM.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/logout"
        android:textColor="@color/error_600"
        app:icon="@drawable/ic_logout"
        app:iconPadding="16dp"
        app:iconTint="@color/error_600" />

</LinearLayout>
