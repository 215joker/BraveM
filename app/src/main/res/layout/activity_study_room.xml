<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parchment_100">

    <!-- Remote Video Grid (Dynamic) -->
    <GridLayout
        android:id="@+id/remote_video_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="1"
        android:rowCount="1" />

    <!-- Full Screen Container for Focused Video -->
    <FrameLayout
        android:id="@+id/full_screen_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/parchment_100" />

    <!-- Remote Placeholder (Initial) -->
    <LinearLayout
        android:id="@+id/remote_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_remote_profile"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.BraveM.Circle"
            app:strokeColor="@color/amber_600"
            app:strokeWidth="3dp" />

        <TextView
            android:id="@+id/text_remote_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Connecting..."
            android:textColor="@color/ink_text"
            android:textSize="20sp"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Header / Status Info -->
    <LinearLayout
        android:id="@+id/call_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_badge_red"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE • STUDY ROOM"
            android:textColor="@color/ink_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_friend"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_add_person"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/ink_text"
            app:backgroundTint="@color/ink_100"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.BraveM.Circle" />
    </LinearLayout>

    <!-- Local Video Container (Draggable) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/local_video_card"
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1.5dp">

        <FrameLayout
            android:id="@+id/local_video_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ink_100" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Controls Container -->
    <HorizontalScrollView
        android:id="@+id/controls_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/controls_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_default"
            android:backgroundTint="@color/ink_100"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mute"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_mic"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/ink_text"
                app:backgroundTint="@color/ink_500"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.BraveM.Circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_video_toggle"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_video"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/ink_text"
                app:backgroundTint="@color/ink_500"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.BraveM.Circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_switch_camera"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_switch_camera"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/ink_text"
                app:backgroundTint="@color/ink_500"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.BraveM.Circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_screen_share"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_screen_share"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/ink_text"
                app:backgroundTint="@color/ink_500"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.BraveM.Circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_end_call"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="20dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_call_end"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp"
                app:iconTint="@color/white"
                app:backgroundTint="@color/error_600"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.BraveM.Circle" />

        </LinearLayout>
    </HorizontalScrollView>

</RelativeLayout>
