<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BraveM" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink_900</item>
        <item name="colorPrimaryVariant">@color/ink_700</item>
        <item name="colorOnPrimary">@color/text_on_ink</item>

        <item name="colorSecondary">@color/amber_600</item>
        <item name="colorSecondaryVariant">@color/amber_700</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <item name="android:colorBackground">@color/parchment_100</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="colorError">@color/error_600</item>

        <item name="android:statusBarColor">@color/ink_900</item>
        <item name="android:navigationBarColor">@color/parchment_100</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <item name="materialButtonStyle">@style/Widget.BraveM.Button</item>
        <item name="textInputStyle">@style/Widget.BraveM.TextInputLayout</item>
    </style>

    <style name="Theme.BraveM.Splash" parent="Theme.BraveM">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/ink_900</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.BraveM.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">serif</item>
        <item name="fontFamily">serif</item>
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="TextAppearance.BraveM.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">serif</item>
        <item name="fontFamily">serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.BraveM.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.BraveM.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.BraveM.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.BraveM.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/amber_700</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- Widgets -->
    <style name="Widget.BraveM.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ink_900</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/text_on_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.BraveM.Button.Accent" parent="Widget.BraveM.Button">
        <item name="backgroundTint">@color/amber_600</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.BraveM.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/ink_900</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.BraveM.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.BraveM.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ink_500</item>
        <item name="hintTextColor">@color/ink_700</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="Widget.BraveM.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.BraveM.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/ink_100</item>
        <item name="android:textColor">@color/ink_900</item>
    </style>

    <style name="Theme.BraveM.AlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Bottom Sheet Styles -->
    <style name="Theme.BraveM.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BraveM.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/parchment_100</item>
    </style>

    <style name="Widget.BraveM.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.BraveM.LargeComponent</item>
        <item name="backgroundTint">@color/parchment_100</item>
    </style>

    <style name="ShapeAppearance.BraveM.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.BraveM.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
