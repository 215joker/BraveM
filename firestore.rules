rules_version = '2';

// Deploy this file via: firebase deploy --only firestore:rules
// Or paste it into Firebase Console > Firestore Database > Rules.
//
// Permission model:
//  - Anyone signed in can read degrees/courses/papers.
//  - Only the user themself can write their own /users/{uid} doc (except role, which
//    is locked down so a student can't self-promote to admin).
//  - Only admins (role == "admin") can create/update/delete degrees and courses.
//  - Any signed-in student can upload (create) a paper; only admins or the original
//    uploader can update/delete it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == "student";
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role; // can't change own role
      allow delete: if false;
    }

    match /degrees/{degreeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /papers/{paperId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploadedByUid == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (isAdmin() || resource.data.uploadedByUid == request.auth.uid);
    }
  }
}
