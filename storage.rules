rules_version = '2';

// Deploy via: firebase deploy --only storage
// Or paste into Firebase Console > Storage > Rules.
//
// Any signed-in student can upload a paper file; anyone signed in can read/download.
// Only the original uploader (or an admin, checked via Firestore lookup) can delete.

service firebase.storage {
  match /b/{bucket}/o {
    match /papers/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.size < 25 * 1024 * 1024 // 25MB max
                    && (request.resource.contentType == 'application/pdf'
                        || request.resource.contentType == 'application/msword'
                        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
      allow update, delete: if request.auth != null;
    }
  }
}
